# Django Core Settings
# Generate a strong random key for production (never commit .env)
SECRET_KEY=replace-with-secure-random-secret-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# -----------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL)
# Leave DATABASE_URL, DB_HOST, and DB_NAME blank to use local SQLite (db.sqlite3).
#
# Option A (Recommended): Paste the Session Pooler or Transaction Pooler URI
# from Supabase Dashboard -> Project Settings / Connect -> URI (ORM / Django).
# Example (Session Pooler, IPv4-compatible, port 5432):
# DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Option B: Set individual fields instead of DATABASE_URL:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.ltcreifkwezxaolvhmgx
DB_PASSWORD=replace-with-supabase-db-password
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require

# Optional: Only needed if you later integrate Supabase Storage or Auth APIs
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=replace-with-supabase-anon-key
